// The consumer program CI builds against the packaged library. It imports
// zhttp::fin exactly the way the README documents, so a broken package layout
// fails here instead of in a user's project.
import { HttpResponse, http_response, http_free_response, http_status_text } from zhttp::fin;

fun main() <noret> {
    let r <&HttpResponse> = http_response(201, "made");
    printf("%s %d %s\n", http_status_text(201), r.status, r.body);
    http_free_response(r);
}
