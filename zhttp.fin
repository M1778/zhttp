// Package entry module: this file is what `import { ... } from zhttp::fin`
// resolves to.
//
// `finn` adds a package's root directory to the module search path, so the
// module named `zhttp` must be a file `zhttp.fin` beside this manifest. The
// implementation lives in src/zhttp.fin; this file exists only to publish its
// `fin` namespace under the package name.
//
// The import is pathless (`src.zhttp`), not `"src/zhttp.fin"`. A quoted import
// is resolved relative to this file at compile time, so it would only work from
// this checkout; a pathless one is looked up in the search paths of whoever is
// compiling, which is what makes the package relocatable.
namespace fin {
import * from src.zhttp;
}
