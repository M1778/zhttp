// zhttp — HTTP/1.1 client and server for Fin.
//
// A small, dependency-free HTTP library: URL parsing, a blocking HTTP client
// (GET/POST), and a blocking HTTP server (accept, read request, write
// response). Transport is raw TCP over IPv4, mirroring the design of
// `networking::std` (blocking sockets, dotted-quad addresses, `blame` for
// programmer errors, explicit error values for I/O failures).
//
// Why the socket layer is vendored here instead of imported from
// networking::std: only `#[global]` externs lower through a module-qualified
// call, and networking.fin's `c_*` externs are not `#[global]`, so importing
// them is refused in the frontend (see docs/guide/10-modules-and-imports.md).
// Most local bindings mirror networking.fin. send/recv use the correct Linux
// size_t/ssize_t ABI; legacy int-sized declarations must not be mixed with these.

import { Collection } from collection::std;
import { len, equals, clone, substr, find, to_chars, from_chars, free_str } from strings::std;

namespace fin {

// ---------------------------------------------------------------------------
// Local C bindings (module-private), targeting 64-bit Linux.
// ---------------------------------------------------------------------------

#[llvm_name="socket"]
@define z_socket(domain: int, kind: int, protocol: int) <int>;

#[llvm_name="connect"]
@define z_connect(fd: int, addr: &int, len: int) <int>;

#[llvm_name="bind"]
@define z_bind(fd: int, addr: &int, len: int) <int>;

#[llvm_name="listen"]
@define z_listen(fd: int, backlog: int) <int>;

#[llvm_name="accept"]
@define z_accept(fd: int, addr: &int, len: &int) <int>;

#[llvm_name="getsockname"]
@define z_getsockname(fd: int, addr: &int, len: &int) <int>;

// Transport constants and errno binding below target Linux/POSIX sockets.
// size_t/ssize_t use the native 64-bit ABI, not Fin int.
#[llvm_name="send"]
@define z_send(fd: int, buf: &char, len: ulong, flags: int) <long>;

#[llvm_name="recv"]
@define z_recv(fd: int, buf: &char, len: ulong, flags: int) <long>;

#[llvm_name="__errno_location"]
@define z_errno() <&int>;

// Functions rather than module constants: imported constants do not lower in
// finc 0.4.0. Header size includes the final CRLFCRLF.
fun z_max_headers() <int> { return 65536; }
fun z_max_body() <int> { return 16777216; }
fun z_max_fields() <int> { return 256; }

#[llvm_name="close"]
@define z_close(fd: int) <int>;

#[llvm_name="inet_addr"]
@define z_inet_addr(cp: string) <int>;

#[llvm_name="calloc"]
@define z_calloc(count: ulong, size: ulong) <string>;

#[llvm_name="free"]
@define z_cfree(p: string) <noret>;

#[llvm_name="snprintf"]
@define z_snprintf(buf: string, size: ulong, fmt: string, ...) <int>;

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------

// Header set: parallel collections (names[i] belongs to values[i]).
// A Collection<HttpHeader> struct element would need struct ==, which the
// backend refuses to lower — hence this shape.
#[export]
pub struct HttpHeaders {
    pub:
        names <&Collection<string>>,
        values <&Collection<string>>,
}

#[export]
pub struct HttpRequest {
    pub:
        method <string>,
        target <string>,
        version <string>,
        headers <&HttpHeaders>,
        body <string>,
}

#[export]
pub struct HttpResponse {
    pub:
        status <int>,
        headers <&HttpHeaders>,
        body <string>,
}

#[export]
pub struct HttpUrl {
    pub:
        scheme <string>,
        host <string>,
        port <int>,
        path <string>,
        query <string>,
}

#[export]
pub struct HttpUrlResult {
    pub:
        ok <bool>,
        url <HttpUrl>,
        err <string>,
}

#[export]
pub struct HttpResult {
    pub:
        ok <bool>,
        status <int>,
        headers <&HttpHeaders>,
        body <string>,
        err <string>,
}

#[export]
pub struct HttpReadResult {
    pub:
        ok <bool>,
        req <&HttpRequest>,
        err <string>,
}

#[export]
pub struct HttpServer {
    pub:
        fd <int>,
}

#[export]
pub struct HttpConn {
    pub:
        fd <int>,
}

// ---------------------------------------------------------------------------
// Internal: growable byte buffer
// ---------------------------------------------------------------------------

struct ZBuf {
    data <[char]>,
    len <int>,
    cap <int>,
}

fun z_buf_new() <&ZBuf> {
    let cap <int> = 4096;
    return new ZBuf{data: new [char, cap]{}, len: 0, cap: cap};
}

fun z_buf_reserve(b: &ZBuf, extra: int) <noret> {
    if (b.len + extra <= b.cap) { return; }
    let want <int> = b.cap * 2;
    while (want < b.len + extra) { want = want * 2; }
    let nd <[char]> = new [char, want]{};
    for (let i <int> = 0; i < b.len; i++) { nd[i] = b.data[i]; }
    delete b.data;
    b.data = nd;
    b.cap = want;
}

fun z_buf_push(b: &ZBuf, c: char) <noret> {
    z_buf_reserve(b, 1);
    b.data[b.len] = c;
    b.len = b.len + 1;
}

fun z_buf_append(b: &ZBuf, bytes: [char], n: int) <noret> {
    if (n <= 0) { return; }
    z_buf_reserve(b, n);
    for (let i <int> = 0; i < n; i++) { b.data[b.len + i] = bytes[i]; }
    b.len = b.len + n;
}

fun z_buf_append_str(b: &ZBuf, s: string) <noret> {
    let m <int> = len(s);
    if (m == 0) { return; }
    z_buf_reserve(b, m);
    let bytes <[char]> = to_chars(s);
    for (let i <int> = 0; i < m; i++) { b.data[b.len + i] = bytes[i]; }
    b.len = b.len + m;
    delete bytes;
}

fun z_buf_to_string(b: &ZBuf) <string> {
    return from_chars(b.data, 0, b.len);
}

fun z_buf_free(b: &ZBuf) <noret> {
    delete b.data;
    delete b;
}

// ---------------------------------------------------------------------------
// Internal: small helpers
// ---------------------------------------------------------------------------

fun z_lower_char(c: char) <char> {
    if (c >= 'A' && c <= 'Z') { return cast<char>(cast<int>(c) + 32); }
    return c;
}

fun z_name_eq(a: string, b: string) <bool> {
    if (len(a) != len(b)) { return false; }
    let ab <[char]> = to_chars(a);
    let bb <[char]> = to_chars(b);
    let n <int> = len(a);
    let same <bool> = true;
    for (let i <int> = 0; i < n; i++) {
        if (z_lower_char(ab[i]) != z_lower_char(bb[i])) {
            same = false;
            break;
        }
    }
    delete ab;
    delete bb;
    return same;
}

// Checked decimal parsing; ports and body lengths have independent limits.
fun z_parse_decimal(text: string, limit: int) <int> {
    let bytes <[char]> = to_chars(text);
    let n <int> = len(text);
    if (n == 0) { delete bytes; return -1; }
    let acc <int> = 0;
    for (let i <int> = 0; i < n; i++) {
        let c <char> = bytes[i];
        if (c < '0' || c > '9') { delete bytes; return -1; }
        let d <int> = cast<int>(c) - cast<int>('0');
        if (acc > (limit - d) / 10) { delete bytes; return -1; }
        acc = acc * 10 + d;
    }
    delete bytes;
    return acc;
}

fun z_parse_uint(text: string) <int> {
    return z_parse_decimal(text, 65535);
}

fun z_itoa(v: int) <string> {
    let tmp <string> = z_calloc(cast<ulong>(24), cast<ulong>(1));
    z_snprintf(tmp, cast<ulong>(24), "%d", v);
    let out <string> = clone(tmp);
    z_cfree(tmp);
    return out;
}

// ---------------------------------------------------------------------------
// URL parsing
// ---------------------------------------------------------------------------

fun z_url_err(msg: string) <HttpUrlResult> {
    return HttpUrlResult{ok: false,
        url: HttpUrl{scheme: "", host: "", port: 0, path: "", query: ""},
        err: clone(msg)};
}

#[export]
pub fun http_parse_url(s: string) <HttpUrlResult> {
    let scheme_end <int> = find(s, "://");
    if (scheme_end < 0) { return z_url_err("missing scheme (expected http://host/...)"); }
    let scheme <string> = substr(s, 0, scheme_end);
    let scheme_lc <[char]> = to_chars(scheme);
    let is_http <bool> = len(scheme) == 4;
    if (is_http) {
        if (!(z_lower_char(scheme_lc[0]) == 'h' && z_lower_char(scheme_lc[1]) == 't' &&
              z_lower_char(scheme_lc[2]) == 't' && z_lower_char(scheme_lc[3]) == 'p')) {
            is_http = false;
        }
    }
    delete scheme_lc;
    if (!is_http) {
        free_str(scheme);
        return z_url_err("unsupported scheme (only http:// in v0.1; no TLS)");
    }
    free_str(scheme);
    let rest <string> = substr(s, scheme_end + 3, len(s) - scheme_end - 3);
    let slash <int> = find(rest, "/");
    let authority <string> = null;
    let pathquery <string> = null;
    if (slash < 0) {
        authority = clone(rest);
        pathquery = clone("/");
    } else {
        authority = substr(rest, 0, slash);
        pathquery = substr(rest, slash, len(rest) - slash);
    }
    free_str(rest);
    if (len(authority) == 0) {
        free_str(authority);
        free_str(pathquery);
        return z_url_err("missing host");
    }
    let colon <int> = find(authority, ":");
    let host <string> = null;
    let port <int> = 80;
    if (colon < 0) {
        host = clone(authority);
    } else {
        host = substr(authority, 0, colon);
        let porttext <string> = substr(authority, colon + 1, len(authority) - colon - 1);
        port = z_parse_uint(porttext);
        free_str(porttext);
        if (port <= 0) {
            free_str(authority);
            free_str(pathquery);
            free_str(host);
            return z_url_err("invalid port");
        }
    }
    free_str(authority);
    let qmark <int> = find(pathquery, "?");
    let path <string> = null;
    let query <string> = null;
    if (qmark < 0) {
        path = clone(pathquery);
        query = clone("");
    } else {
        path = substr(pathquery, 0, qmark);
        query = substr(pathquery, qmark + 1, len(pathquery) - qmark - 1);
    }
    free_str(pathquery);
    return HttpUrlResult{ok: true,
        url: HttpUrl{scheme: clone("http"), host: host, port: port, path: path, query: query},
        err: ""};
}

#[export]
pub fun http_free_url_result(r: &HttpUrlResult) <noret> {
    if (r.ok) {
        free_str(r.url.scheme);
        free_str(r.url.host);
        free_str(r.url.path);
        free_str(r.url.query);
    } else {
        free_str(r.err);
    }
}

// ---------------------------------------------------------------------------
// Status codes and headers
// ---------------------------------------------------------------------------

// Static string — do NOT free the result.
#[export]
pub fun http_status_text(code: int) <string> {
    if (code == 200) { return "OK"; }
    if (code == 201) { return "Created"; }
    if (code == 204) { return "No Content"; }
    if (code == 301) { return "Moved Permanently"; }
    if (code == 302) { return "Found"; }
    if (code == 304) { return "Not Modified"; }
    if (code == 400) { return "Bad Request"; }
    if (code == 401) { return "Unauthorized"; }
    if (code == 403) { return "Forbidden"; }
    if (code == 404) { return "Not Found"; }
    if (code == 405) { return "Method Not Allowed"; }
    if (code == 409) { return "Conflict"; }
    if (code == 422) { return "Unprocessable Entity"; }
    if (code == 500) { return "Internal Server Error"; }
    if (code == 501) { return "Not Implemented"; }
    if (code == 503) { return "Service Unavailable"; }
    return "Unknown";
}

// Creates an empty header set. Free with http_free_headers.
#[export]
pub fun http_new_headers() <&HttpHeaders> {
    return new HttpHeaders{names: new Collection::<string>{},
                           values: new Collection::<string>{}};
}

#[export]
pub fun http_free_headers(hdrs: &HttpHeaders) <noret> {
    if (hdrs == null) { return; }
    let n <int> = hdrs.names.len();
    for (let i <int> = 0; i < n; i++) {
        free_str(hdrs.names.get(i));
        free_str(hdrs.values.get(i));
    }
    delete hdrs.names;
    delete hdrs.values;
    delete hdrs;
}

#[export]
pub fun http_header_has(hdrs: &HttpHeaders, name: string) <bool> {
    let n <int> = hdrs.names.len();
    for (let i <int> = 0; i < n; i++) {
        if (z_name_eq(hdrs.names.get(i), name)) { return true; }
    }
    return false;
}

// Returns the header value, or "" when absent (use http_header_has to tell
// the two apart — finc 0.4.0 does not allow a Fin function to return null
// as a string). Borrowed — do not free.
#[export]
pub fun http_header_get(hdrs: &HttpHeaders, name: string) <string> {
    let n <int> = hdrs.names.len();
    for (let i <int> = 0; i < n; i++) {
        if (z_name_eq(hdrs.names.get(i), name)) { return hdrs.values.get(i); }
    }
    return "";
}

// Sets a header, replacing any existing one (case-insensitive). Copies both.
#[export]
pub fun http_header_set(hdrs: &HttpHeaders, name: string, value: string) <noret> {
    let n <int> = hdrs.names.len();
    for (let i <int> = 0; i < n; i++) {
        if (z_name_eq(hdrs.names.get(i), name)) {
            free_str(hdrs.values.get(i));
            hdrs.values.set(i, clone(value));
            return;
        }
    }
    hdrs.names.push(clone(name));
    hdrs.values.push(clone(value));
}

// Number of headers in the set.
#[export]
pub fun http_header_count(hdrs: &HttpHeaders) <int> {
    return hdrs.names.len();
}

// Name/value of the i-th header. Borrowed — do not free.
#[export]
pub fun http_header_name(hdrs: &HttpHeaders, i: int) <string> {
    return hdrs.names.get(i);
}

#[export]
pub fun http_header_value(hdrs: &HttpHeaders, i: int) <string> {
    return hdrs.values.get(i);
}

// ---------------------------------------------------------------------------
// Request / response construction and memory
// ---------------------------------------------------------------------------

#[export]
pub fun http_response(status: int, body: string) <&HttpResponse> {
    let r <&HttpResponse> = new HttpResponse{status: status,
        headers: http_new_headers(), body: clone(body)};
    http_header_set(r.headers, "Content-Type", "text/plain; charset=utf-8");
    let lens <string> = z_itoa(len(body));
    if (status >= 200 && status != 204) {
        http_header_set(r.headers, "Content-Length", lens);
    }
    free_str(lens);
    return r;
}

#[export]
pub fun http_response_with_type(status: int, content_type: string, body: string) <&HttpResponse> {
    let r <&HttpResponse> = http_response(status, body);
    http_header_set(r.headers, "Content-Type", content_type);
    return r;
}

#[export]
pub fun http_free_response(r: &HttpResponse) <noret> {
    if (r == null) { return; }
    http_free_headers(r.headers);
    free_str(r.body);
    delete r;
}

#[export]
pub fun http_free_request(q: &HttpRequest) <noret> {
    if (q == null) { return; }
    free_str(q.method);
    free_str(q.target);
    free_str(q.version);
    http_free_headers(q.headers);
    free_str(q.body);
    delete q;
}

#[export]
pub fun http_free_read_result(rr: &HttpReadResult) <noret> {
    if (rr.ok) {
        http_free_request(rr.req);
    } else {
        free_str(rr.err);
    }
}

#[export]
pub fun http_free_result(r: &HttpResult) <noret> {
    if (r.headers != null) { http_free_headers(r.headers); }
    if (r.ok) {
        free_str(r.body);
    } else {
        free_str(r.err);
    }
}

// ---------------------------------------------------------------------------
// Internal: TCP plumbing
// ---------------------------------------------------------------------------

fun z_sockaddr(host: string, port: int) <[int]> {
    let a <int> = z_inet_addr(host);
    blame a != -1, "cannot parse the address as a dotted quad";
    let addr <[int]> = new [int, 4]{};
    addr[0] = cast<int>(2 + cast<long>(port / 256) * 65536 +
                        cast<long>(port % 256) * 16777216);
    addr[1] = a;
    return addr;
}

// Returns a connected fd, or -1 on any failure (never blames).
fun z_dial(host: string, port: int) <int> {
    if (port <= 0 || port > 65535) { return -1; }
    let a <int> = z_inet_addr(host);
    if (a == -1) { return -1; }
    let addr <[int]> = z_sockaddr(host, port);
    let fd <int> = z_socket(2, 1, 0);
    if (fd < 0) { delete addr; return -1; }
    let err <int> = z_connect(fd, &addr[0], 16);
    delete addr;
    if (err != 0) { z_close(fd); return -1; }
    return fd;
}

// Linux EINTR is 4; MSG_NOSIGNAL is 0x4000. Do not change process-wide
// signal handlers: embedding applications retain ownership of their signals.
fun z_recv_retry(fd: int, bytes: [char], n: int, flags: int) <int> {
    while (true) {
        let got <long> = z_recv(fd, &bytes[0], cast<ulong>(n), flags);
        if (got >= 0) { return cast<int>(got); }
        if (*z_errno() != 4) { return -1; }
    }
    return -1;
}

fun z_send_all(fd: int, bytes: [char], n: int) <bool> {
    let sent <int> = 0;
    while (sent < n) {
        let got <long> = z_send(fd, &bytes[sent], cast<ulong>(n - sent), 16384);
        if (got < 0) {
            if (*z_errno() == 4) { continue; }
            return false;
        }
        if (got == 0) { return false; }
        sent = sent + cast<int>(got);
    }
    return true;
}

fun z_send_str(fd: int, s: string) <bool> {
    let bytes <[char]> = to_chars(s);
    let ok <bool> = z_send_all(fd, bytes, len(s));
    delete bytes;
    return ok;
}

// Bounded close-delimited response body. One scratch allocation per read.
fun z_read_all(fd: int) <&ZBuf> {
    let b <&ZBuf> = z_buf_new();
    let chunk <[char]> = new [char, 8192]{};
    while (true) {
        let got <int> = z_recv_retry(fd, chunk, 8192, 0);
        if (got < 0 || got > z_max_body() - b.len) {
            delete chunk;
            z_buf_free(b);
            return null;
        }
        if (got == 0) { break; }
        z_buf_append(b, chunk, got);
    }
    delete chunk;
    return b;
}

// Peek ahead, but consume only through CRLFCRLF. No body or protocol-upgrade
// bytes are lost, including when the first WebSocket frame arrives with headers.
fun z_read_headers(fd: int) <&ZBuf> {
    let b <&ZBuf> = z_buf_new();
    let chunk <[char]> = new [char, 4096]{};
    let matched <int> = 0;
    let done <bool> = false;
    while (!done) {
        let cap <int> = z_max_headers() - b.len;
        if (cap > 4096) { cap = 4096; }
        if (cap == 0) { delete chunk; z_buf_free(b); return null; }
        let got <int> = z_recv_retry(fd, chunk, cap, 2); // MSG_PEEK
        if (got <= 0) { delete chunk; z_buf_free(b); return null; }
        let take <int> = got;
        for (let i <int> = 0; i < got; i++) {
            let c <char> = chunk[i];
            if (c == cast<char>(0)) { delete chunk; z_buf_free(b); return null; }
            if (matched == 0 || matched == 2) {
                if (c == '\r') { matched++; } else { matched = 0; }
            } else {
                if (c == '\n') { matched++; }
                else if (c == '\r') { matched = 1; }
                else { matched = 0; }
            }
            if (matched == 4) { take = i + 1; done = true; break; }
        }
        // A single owner reads each connection. Partial recv is still legal.
        let left <int> = take;
        while (left > 0) {
            let used <int> = z_recv_retry(fd, chunk, left, 0);
            if (used <= 0) { delete chunk; z_buf_free(b); return null; }
            z_buf_append(b, chunk, used);
            left = left - used;
        }
    }
    delete chunk;
    return b;
}

// Reads exactly `want` more bytes; callers enforce the appropriate size limit.
fun z_read_exact(fd: int, b: &ZBuf, want: int) <bool> {
    let need <int> = want;
    let chunk <[char]> = new [char, 8192]{};
    while (need > 0) {
        let cap <int> = 8192;
        if (need < cap) { cap = need; }
        let got <int> = z_recv_retry(fd, chunk, cap, 0);
        if (got <= 0) { delete chunk; return false; }
        z_buf_append(b, chunk, got);
        need = need - got;
    }
    delete chunk;
    return true;
}

// ---------------------------------------------------------------------------
// Internal: message parsing
// ---------------------------------------------------------------------------

fun z_read_err(msg: string) <HttpReadResult> {
    return HttpReadResult{ok: false, req: null, err: clone(msg)};
}

fun z_token(c: char) <bool> {
    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')) { return true; }
    return c == '!' || c == '#' || c == '$' || c == '%' || c == '&' ||
        c == '\'' || c == '*' || c == '+' || c == '-' || c == '.' ||
        c == '^' || c == '_' || c == '`' || c == '|' || c == '~';
}

// Parse a byte span; only SP/HTAB are OWS. Whitespace before ':' and
// obs-fold are invalid. Duplicate framing fields must never be overwritten.
fun z_parse_field(bytes: [char], start: int, end: int, hdrs: &HttpHeaders, trailer: bool) <bool> {
    let colon <int> = start;
    while (colon < end && bytes[colon] != ':') {
        if (!z_token(bytes[colon])) { return false; }
        colon++;
    }
    if (colon == start || colon == end) { return false; }
    let low <int> = colon + 1;
    let high <int> = end;
    for (let i <int> = low; i < high; i++) {
        let c <char> = bytes[i];
        if ((cast<int>(c) < 32 && c != '\t') || c == cast<char>(127)) { return false; }
    }
    while (low < high && (bytes[low] == ' ' || bytes[low] == '\t')) { low++; }
    while (high > low && (bytes[high - 1] == ' ' || bytes[high - 1] == '\t')) { high--; }
    let name <string> = from_chars(bytes, start, colon - start);
    let framing <bool> = z_name_eq(name, "Content-Length") || z_name_eq(name, "Transfer-Encoding");
    let singleton <bool> = framing || z_name_eq(name, "Host") ||
        z_name_eq(name, "Sec-WebSocket-Key") || z_name_eq(name, "Sec-WebSocket-Version") ||
        z_name_eq(name, "Sec-WebSocket-Accept");
    if ((singleton && http_header_has(hdrs, name)) || (framing && trailer) ||
        (trailer && (z_name_eq(name, "Host") || z_name_eq(name, "Connection") || z_name_eq(name, "Trailer")))) {
        free_str(name);
        return false;
    }
    let value <string> = from_chars(bytes, low, high - low);
    http_header_set(hdrs, name, value);
    free_str(name);
    free_str(value);
    return true;
}

// Single byte scan: no remaining-block substr allocation for each field.
// Any malformed line fails the whole message, not just that header.
fun z_parse_header_block(text: string, hdrs: &HttpHeaders) <bool> {
    let bytes <[char]> = to_chars(text);
    let total <int> = len(text);
    let start <int> = 0;
    let pos <int> = 0;
    let count <int> = 0;
    while (pos < total) {
        if (bytes[pos] == '\n') { delete bytes; return false; }
        if (bytes[pos] == '\r') {
            if (pos + 1 >= total || bytes[pos + 1] != '\n' || count >= z_max_fields() ||
                !z_parse_field(bytes, start, pos, hdrs, false)) { delete bytes; return false; }
            count++;
            pos = pos + 2;
            start = pos;
        } else { pos++; }
    }
    if (start < total) {
        if (count >= z_max_fields() || !z_parse_field(bytes, start, total, hdrs, false)) { delete bytes; return false; }
    }
    delete bytes;
    return true;
}

// -1 is invalid, -2 is chunked, -3 is close-delimited/absent.
fun z_body_length(hdrs: &HttpHeaders, request: bool) <int> {
    let te <bool> = http_header_has(hdrs, "Transfer-Encoding");
    let cl <bool> = http_header_has(hdrs, "Content-Length");
    if (te && cl) { return -1; }
    if (te) {
        if (request || !z_name_eq(http_header_get(hdrs, "Transfer-Encoding"), "chunked")) { return -1; }
        return -2;
    }
    if (cl) { return z_parse_decimal(http_header_get(hdrs, "Content-Length"), z_max_body()); }
    return -3;
}

// Read one CRLF-terminated line without consuming following bytes.
fun z_read_line(fd: int, b: &ZBuf, limit: int) <bool> {
    let chunk <[char]> = new [char, 4096]{};
    let cr <bool> = false;
    let done <bool> = false;
    while (!done) {
        let cap <int> = limit - b.len;
        if (cap > 4096) { cap = 4096; }
        if (cap <= 0) { delete chunk; return false; }
        let got <int> = z_recv_retry(fd, chunk, cap, 2);
        if (got <= 0) { delete chunk; return false; }
        let take <int> = got;
        for (let i <int> = 0; i < got; i++) {
            let c <char> = chunk[i];
            if (c == cast<char>(0) || (cr && c != '\n') || (!cr && c == '\n')) { delete chunk; return false; }
            if (cr) { take = i + 1; done = true; break; }
            cr = c == '\r';
        }
        let left <int> = take;
        while (left > 0) {
            let used <int> = z_recv_retry(fd, chunk, left, 0);
            if (used <= 0) { delete chunk; return false; }
            z_buf_append(b, chunk, used);
            left = left - used;
        }
    }
    delete chunk;
    return true;
}

// Strict size and token/quoted-string extension syntax, with checked arithmetic.
fun z_chunk_size(line: &ZBuf) <int> {
    let end <int> = line.len - 2;
    let pos <int> = 0;
    let size <int> = 0;
    while (pos < end) {
        let c <char> = line.data[pos];
        let d <int> = -1;
        if (c >= '0' && c <= '9') { d = cast<int>(c) - 48; }
        else if (c >= 'a' && c <= 'f') { d = cast<int>(c) - 87; }
        else if (c >= 'A' && c <= 'F') { d = cast<int>(c) - 55; }
        if (d < 0) { break; }
        if (size > (z_max_body() - d) / 16) { return -1; }
        size = size * 16 + d;
        pos++;
    }
    if (pos == 0) { return -1; }
    while (pos < end) {
        while (pos < end && (line.data[pos] == ' ' || line.data[pos] == '\t')) { pos++; }
        if (pos >= end || line.data[pos] != ';') { return -1; }
        pos++;
        while (pos < end && (line.data[pos] == ' ' || line.data[pos] == '\t')) { pos++; }
        let start <int> = pos;
        while (pos < end && z_token(line.data[pos])) { pos++; }
        if (pos == start) { return -1; }
        while (pos < end && (line.data[pos] == ' ' || line.data[pos] == '\t')) { pos++; }
        if (pos < end && line.data[pos] == '=') {
            pos++;
            while (pos < end && (line.data[pos] == ' ' || line.data[pos] == '\t')) { pos++; }
            if (pos < end && line.data[pos] == '"') {
                pos++;
                let closed <bool> = false;
                while (pos < end) {
                    let c <char> = line.data[pos];
                    pos++;
                    if (c == '"') { closed = true; break; }
                    if (c == '\\') {
                        if (pos >= end) { return -1; }
                        c = line.data[pos];
                        pos++;
                    }
                    if ((cast<int>(c) < 32 && c != '\t') || c == cast<char>(127)) { return -1; }
                }
                if (!closed) { return -1; }
            } else {
                start = pos;
                while (pos < end && z_token(line.data[pos])) { pos++; }
                if (pos == start) { return -1; }
            }
        }
    }
    return size;
}

// Completion requires the zero chunk AND a valid terminated trailer section.
fun z_read_chunked(fd: int) <&ZBuf> {
    let body <&ZBuf> = z_buf_new();
    let line <&ZBuf> = z_buf_new();
    let trailers <&HttpHeaders> = http_new_headers();
    let metadata <int> = 0;
    let fields <int> = 0;
    let terminal <bool> = false;
    let ok <bool> = true;
    while (true) {
        line.len = 0;
        let limit <int> = z_max_headers() - metadata;
        if (limit > 8192) { limit = 8192; }
        if (!z_read_line(fd, line, limit)) { ok = false; break; }
        metadata = metadata + line.len;
        if (terminal) {
            if (line.len == 2) { break; }
            if (fields >= z_max_fields() || !z_parse_field(line.data, 0, line.len - 2, trailers, true)) { ok = false; break; }
            fields++;
        } else {
            let size <int> = z_chunk_size(line);
            if (size < 0 || size > z_max_body() - body.len) { ok = false; break; }
            if (size == 0) { terminal = true; continue; }
            if (metadata > z_max_headers() - 2) { ok = false; break; }
            metadata = metadata + 2;
            if (!z_read_exact(fd, body, size)) { ok = false; break; }
            line.len = 0;
            if (!z_read_exact(fd, line, 2) || line.data[0] != '\r' || line.data[1] != '\n') { ok = false; break; }
        }
    }
    http_free_headers(trailers);
    z_buf_free(line);
    if (!ok) { z_buf_free(body); return null; }
    return body;
}

fun z_http_err(msg: string) <HttpResult> {
    return HttpResult{ok: false, status: 0, headers: null, body: "", err: clone(msg)};
}

// The first line ends at CRLF; a headerless message is legal.
fun z_first_line(raw: &ZBuf) <int> {
    for (let i <int> = 0; i + 1 < raw.len; i++) {
        if (raw.data[i] == '\r' && raw.data[i + 1] == '\n') { return i; }
        if (raw.data[i] == '\r' || raw.data[i] == '\n' || cast<int>(raw.data[i]) < 32 || raw.data[i] == cast<char>(127)) { return -1; }
    }
    return -1;
}

// Read one framed response. Skip bounded informational responses; this GET/POST
// client does not support 101 (the raw server API supports upgrades).
fun z_read_response(fd: int) <HttpResult> {
    let interim <int> = 0;
    while (true) {
        let raw <&ZBuf> = z_read_headers(fd);
        if (raw == null) { return z_http_err("cannot read response headers (invalid or >64KiB)"); }
        let eol <int> = z_first_line(raw);
        let valid <bool> = eol >= 13;
        let status <int> = 0;
        if (valid) {
            let prefix <string> = from_chars(raw.data, 0, 9);
            valid = equals(prefix, "HTTP/1.1 ") || equals(prefix, "HTTP/1.0 ");
            free_str(prefix);
            if (raw.data[12] != ' ') { valid = false; }
            let code <string> = from_chars(raw.data, 9, 3);
            status = z_parse_decimal(code, 999);
            free_str(code);
            if (status < 100) { valid = false; }
        }
        let hdrs <&HttpHeaders> = http_new_headers();
        if (valid) {
            let rest <string> = from_chars(raw.data, eol + 2, raw.len - eol - 4);
            valid = z_parse_header_block(rest, hdrs);
            free_str(rest);
        }
        z_buf_free(raw);
        let want <int> = z_body_length(hdrs, false);
        if (!valid || want == -1 || status == 101 || (status < 200 && interim >= 16)) {
            http_free_headers(hdrs);
            return z_http_err("malformed or unsupported response framing");
        }
        if (status < 200 || status == 204) {
            if (http_header_has(hdrs, "Content-Length") || http_header_has(hdrs, "Transfer-Encoding")) {
                http_free_headers(hdrs);
                return z_http_err("framing forbidden for this response status");
            }
            if (status < 200) { http_free_headers(hdrs); interim++; continue; }
        }
        let body <&ZBuf> = null;
        if (status == 204 || status == 304) {
            body = z_buf_new();
        } else if (want == -2) {
            body = z_read_chunked(fd);
        } else if (want >= 0) {
            body = z_buf_new();
            if (!z_read_exact(fd, body, want)) { z_buf_free(body); body = null; }
        } else {
            body = z_read_all(fd);
        }
        if (body == null) {
            http_free_headers(hdrs);
            return z_http_err("invalid, incomplete, or oversized response body");
        }
        let text <string> = z_buf_to_string(body);
        z_buf_free(body);
        return HttpResult{ok: true, status: status, headers: hdrs, body: text, err: ""};
    }
    return z_http_err("cannot read response");
}

// ---------------------------------------------------------------------------
// Client
// ---------------------------------------------------------------------------

fun z_http_do(method: string, url: string, content_type: string, body: string, has_body: bool) <HttpResult> {
    let parsed <HttpUrlResult> = http_parse_url(url);
    if (!parsed.ok) {
        let r <HttpResult> = z_http_err(parsed.err);
        free_str(parsed.err);
        return r;
    }
    let fd <int> = z_dial(parsed.url.host, parsed.url.port);
    if (fd < 0) {
        let msg <string> = z_calloc(cast<ulong>(128), cast<ulong>(1));
        z_snprintf(msg, cast<ulong>(128), "cannot connect to %s:%d", parsed.url.host, parsed.url.port);
        let r2 <HttpResult> = z_http_err(msg);
        z_cfree(msg);
        http_free_url_result(&parsed);
        return r2;
    }
    let req <&ZBuf> = z_buf_new();
    z_buf_append_str(req, method);
    z_buf_push(req, ' ');
    z_buf_append_str(req, parsed.url.path);
    if (len(parsed.url.query) > 0) {
        z_buf_push(req, '?');
        z_buf_append_str(req, parsed.url.query);
    }
    z_buf_append_str(req, " HTTP/1.1\r\nHost: ");
    z_buf_append_str(req, parsed.url.host);
    if (parsed.url.port != 80) {
        z_buf_push(req, ':');
        let ports <string> = z_itoa(parsed.url.port);
        z_buf_append_str(req, ports);
        free_str(ports);
    }
    z_buf_append_str(req, "\r\nUser-Agent: zhttp/0.1.0\r\nConnection: close\r\n");
    if (has_body) {
        z_buf_append_str(req, "Content-Type: ");
        z_buf_append_str(req, content_type);
        z_buf_append_str(req, "\r\nContent-Length: ");
        let lens <string> = z_itoa(len(body));
        z_buf_append_str(req, lens);
        free_str(lens);
        z_buf_append_str(req, "\r\n");
    }
    z_buf_append_str(req, "\r\n");
    if (has_body) {
        z_buf_append_str(req, body);
    }
    http_free_url_result(&parsed);
    if (!z_send_all(fd, req.data, req.len)) {
        z_buf_free(req);
        z_close(fd);
        return z_http_err("send failed");
    }
    z_buf_free(req);
    let result <HttpResult> = z_read_response(fd);
    z_close(fd);
    return result;
}

#[export]
pub fun http_get(url: string) <HttpResult> {
    return z_http_do("GET", url, "", "", false);
}

#[export]
pub fun http_post(url: string, content_type: string, body: string) <HttpResult> {
    return z_http_do("POST", url, content_type, body, true);
}

// ---------------------------------------------------------------------------
// Server
// ---------------------------------------------------------------------------

#[export]
pub fun http_listen(port: int) <&HttpServer> {
    blame port >= 0, "http_listen: port cannot be negative";
    blame port <= 65535, "http_listen: port out of range";
    let addr <[int]> = z_sockaddr("0.0.0.0", port);
    let fd <int> = z_socket(2, 1, 0);
    blame fd >= 0, "http_listen: cannot open socket";
    let bound <int> = z_bind(fd, &addr[0], 16);
    if (bound != 0) {
        z_close(fd);
        delete addr;
        blame bound == 0, "http_listen: cannot bind (port in use?)";
    }
    let err <int> = z_listen(fd, 16);
    if (err != 0) {
        z_close(fd);
        delete addr;
        blame err == 0, "http_listen: cannot listen";
    }
    delete addr;
    return new HttpServer{fd: fd};
}

// The port the server is bound to (useful with http_listen(0)).
#[export]
pub fun http_server_port(srv: &HttpServer) <int> {
    let got <[int]> = new [int, 4]{};
    let glen <int> = 16;
    let r <int> = z_getsockname(srv.fd, &got[0], &glen);
    blame r == 0, "http_server_port: cannot read local address";
    let u <uint> = cast<uint>(got[0]);
    let hi <uint> = (u / cast<uint>(65536)) % cast<uint>(256);
    let lo <uint> = (u / cast<uint>(16777216)) % cast<uint>(256);
    delete got;
    return cast<int>(hi * cast<uint>(256) + lo);
}

#[export]
pub fun http_accept(srv: &HttpServer) <&HttpConn> {
    let peer <[int]> = new [int, 4]{};
    let peerlen <int> = 16;
    let fd <int> = z_accept(srv.fd, &peer[0], &peerlen);
    while (fd < 0 && *z_errno() == 4) {
        peerlen = 16;
        fd = z_accept(srv.fd, &peer[0], &peerlen);
    }
    delete peer;
    blame fd >= 0, "http_accept: cannot accept connection";
    return new HttpConn{fd: fd};
}

#[export]
pub fun http_read_request(conn: &HttpConn) <HttpReadResult> {
    let raw <&ZBuf> = z_read_headers(conn.fd);
    if (raw == null) {
        return z_read_err("cannot read request headers (EOF, error, or headers > 64KiB)");
    }
    let eol <int> = z_first_line(raw);
    if (eol < 0) {
        z_buf_free(raw);
        return z_read_err("malformed request line");
    }
    let request_line <string> = from_chars(raw.data, 0, eol);
    let rest <string> = from_chars(raw.data, eol + 2, raw.len - eol - 4);
    let sp1 <int> = find(request_line, " ");
    if (sp1 < 0) {
        free_str(request_line);
        free_str(rest);
        z_buf_free(raw);
        return z_read_err("malformed request line");
    }
    let method <string> = substr(request_line, 0, sp1);
    let after <string> = substr(request_line, sp1 + 1, len(request_line) - sp1 - 1);
    free_str(request_line);
    let sp2 <int> = find(after, " ");
    if (sp2 < 0) {
        free_str(method);
        free_str(after);
        free_str(rest);
        z_buf_free(raw);
        return z_read_err("malformed request line");
    }
    let target <string> = substr(after, 0, sp2);
    let version <string> = substr(after, sp2 + 1, len(after) - sp2 - 1);
    free_str(after);
    let valid <bool> = len(method) > 0 && len(target) > 0 &&
        (equals(version, "HTTP/1.1") || equals(version, "HTTP/1.0"));
    let mb <[char]> = to_chars(method);
    for (let i <int> = 0; i < len(method); i++) {
        if (!z_token(mb[i])) { valid = false; }
    }
    delete mb;
    let hdrs <&HttpHeaders> = http_new_headers();
    if (!z_parse_header_block(rest, hdrs)) { valid = false; }
    free_str(rest);
    let want <int> = z_body_length(hdrs, true);
    if (!valid || want == -1) {
        z_buf_free(raw);
        http_free_headers(hdrs);
        free_str(method);
        free_str(target);
        free_str(version);
        return z_read_err("malformed request or unsupported framing");
    }
    raw.len = 0;
    if (want > 0 && !z_read_exact(conn.fd, raw, want)) {
        z_buf_free(raw);
        http_free_headers(hdrs);
        free_str(method);
        free_str(target);
        free_str(version);
        return z_read_err("body shorter than Content-Length");
    }
    let body <string> = z_buf_to_string(raw);
    z_buf_free(raw);
    let req <&HttpRequest> = new HttpRequest{method: method, target: target, version: version,
                                            headers: hdrs, body: body};
    return HttpReadResult{ok: true, req: req, err: ""};
}

#[export]
pub fun http_write_response(conn: &HttpConn, resp: &HttpResponse) <bool> {
    let out <&ZBuf> = z_buf_new();
    z_buf_append_str(out, "HTTP/1.1 ");
    let codes <string> = z_itoa(resp.status);
    z_buf_append_str(out, codes);
    free_str(codes);
    z_buf_push(out, ' ');
    z_buf_append_str(out, http_status_text(resp.status));
    z_buf_append_str(out, "\r\n");
    let n <int> = http_header_count(resp.headers);
    let no_body <bool> = resp.status < 200 || resp.status == 204 || resp.status == 304;
    let has_length <bool> = false;
    for (let i <int> = 0; i < n; i++) {
        let hname <string> = http_header_name(resp.headers, i);
        if ((resp.status < 200 || resp.status == 204) &&
            (z_name_eq(hname, "Content-Length") || z_name_eq(hname, "Transfer-Encoding"))) { continue; }
        z_buf_append_str(out, hname);
        z_buf_append_str(out, ": ");
        z_buf_append_str(out, http_header_value(resp.headers, i));
        z_buf_append_str(out, "\r\n");
        if (z_name_eq(hname, "Content-Length")) { has_length = true; }
    }
    if (!has_length && !no_body) {
        z_buf_append_str(out, "Content-Length: ");
        let lens <string> = z_itoa(len(resp.body));
        z_buf_append_str(out, lens);
        free_str(lens);
        z_buf_append_str(out, "\r\n");
    }
    z_buf_append_str(out, "Connection: close\r\n\r\n");
    if (resp.body != null && !no_body) {
        z_buf_append_str(out, resp.body);
    }
    let ok <bool> = z_send_all(conn.fd, out.data, out.len);
    z_buf_free(out);
    return ok;
}

// Writes raw bytes on the connection (e.g. for protocol upgrades such as
// WebSocket handshakes, or responses with unusual framing). False on failure.
#[export]
pub fun http_write_raw(conn: &HttpConn, text: string) <bool> {
    return z_send_str(conn.fd, text);
}

// Transfer fd ownership to the caller, freeing only the connection wrapper.
// The caller must eventually close the returned fd; conn is invalid afterwards.
#[export]
pub fun http_detach(conn: &HttpConn) <int> {
    if (conn == null) { return -1; }
    let fd <int> = conn.fd;
    delete conn;
    return fd;
}

#[export]
pub fun http_close(conn: &HttpConn) <noret> {
    if (conn == null) { return; }
    z_close(conn.fd);
    delete conn;
}

#[export]
pub fun http_server_close(srv: &HttpServer) <noret> {
    if (srv == null) { return; }
    z_close(srv.fd);
    delete srv;
}

}
